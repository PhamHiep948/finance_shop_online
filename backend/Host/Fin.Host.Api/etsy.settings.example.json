{
  // ================== CẤU HÌNH ETSY ==================
  // Lấy ở https://www.etsy.com/developers/your-apps  (mục "Keystring" và "Shared Secret").
  // Điền đủ 2 ô ApiKey / SharedSecret rồi lưu file là app tự chuyển sang dữ liệu thật
  // (không cần khởi động lại backend). Để trống thì không lấy được đơn Etsy.
  "Etsy": {
    // Keystring của app Etsy
    "ApiKey": "",
    // Shared Secret của app Etsy (giữ bí mật như mật khẩu)
    "SharedSecret": "",
    // Mã số shop (dạng số). Để trống: app tự lấy từ tài khoản Etsy khi bấm "Kết nối Etsy"
    "ShopId": "",
    // Phải khai báo y hệt ở mục "Callback URLs" của app Etsy
    "RedirectUri": "http://localhost:5000/api/v1/etsy/callback",
    // Đơn bằng EUR quy đổi theo tỷ giá tự nhập của tháng (trang "Tỷ giá"); tháng chưa nhập tạm tính 1 EUR = 1 USD.
    // Số dưới đây chỉ là tỷ giá tham khảo dự phòng khi không lấy được tỷ giá ECB (mất mạng...).
    "EurToUsd": 1.087,
    // % VAT Etsy đã thu hộ cho đơn trong EU: tiền nhận về được ghi luôn vào "Sau thuế"
    "EuVatPercent": 19,
    // Loại phí (ledger_type trong sổ Etsy Payments) tính thêm vào tiền quảng cáo, ngoài Etsy Ads / Offsite Ads
    // mà app đã tự nhận ra. Thường để trống; chỉ điền khi Etsy đổi tên loại phí, ví dụ [ "marketing_fee" ].
    "AdLedgerTypes": []
  }
}
